/// Git lifecycle checks for flip-x.
amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

min_hk_version = "1.55.0"
fail_fast = false

local format = (Builtins.oxfmt) {
  prefix = "pnpm exec"
  batch = true
  check_list_files = null
}

local commit_checks = new Mapping<String, Step> {
  ["format"] = format
  ["lint"] {
    check = new CommandSpec {
      command = "pnpm lint:core"
      effect = "read"
    }
  }
  ["i18n"] {
    check = new CommandSpec {
      command = "pnpm i18n:check"
      effect = "read"
    }
  }
  ["fallow-audit"] {
    check = new CommandSpec {
      command = "pnpm fallow:audit"
      effect = "write"
    }
  }
}

local secrets = new Mapping<String, Step> {
  ["secrets"] = Builtins.kingfisher
}

local push_checks = new Mapping<String, Step> {
  ["format"] = format
  ["lint"] {
    check = new CommandSpec {
      command = "pnpm lint"
      effect = "read"
    }
  }
  ["i18n"] {
    check = new CommandSpec {
      command = "pnpm i18n:check"
      effect = "read"
    }
  }
  ["fallow"] {
    check = new CommandSpec {
      command = "pnpm test:coverage && pnpm fallow:ci"
      effect = "write"
    }
  }
  ["design"] {
    glob = "DESIGN.md"
    check = new CommandSpec {
      command = "pnpm design:lint"
      effect = "read"
    }
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ...commit_checks
      ...secrets
      ["react-doctor"] {
        types = List("javascript", "typescript")
        check = new CommandSpec {
          command = "pnpm doctor:staged"
          effect = "read"
        }
      }
    }
  }
  ["pre-push"] {
    steps = push_checks
  }
  ["check"] {
    steps {
      ...commit_checks
      ...secrets
    }
  }
  ["fix"] {
    fix = true
    steps = commit_checks
  }
}
