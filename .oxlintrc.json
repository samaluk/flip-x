{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript", "react", "jsx-a11y", "unicorn"],
  "jsPlugins": ["eslint-plugin-i18next"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    // Convex documents use `_id`; Effect tagged errors use `_tag`.
    "no-underscore-dangle": ["error", { "allow": ["_id", "_tag"] }],
    // TypeScript escape-hatch rules: forbid `any`, unsafe assertions, non-null
    // assertions, and unsafe operations on `any`. Pre-existing violations are
    // suppressed inline with `oxlint-disable-*` comments; search `rg
    // 'oxlint-disable'` to find and remove them incrementally.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-ignore": true, "ts-nocheck": true, "ts-expect-error": "allow-with-description" }
    ],
    // Type-aware rollout: keep the noisiest strict rules visible but non-blocking.
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/consistent-return": "warn",
    "typescript/no-unnecessary-type-arguments": "warn",
    "typescript/no-unnecessary-type-parameters": "warn",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/no-misused-promises": "warn",
    "typescript/no-floating-promises": "error",
    "i18next/no-literal-string": ["error", { "markupOnly": true }]
  }
}
