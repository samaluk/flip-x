{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,route,default}.{ts,tsx}",
    "confect/tables/**/*.ts",
    "convex/**/*.ts",
    "shared/i18n/request.ts"
  ],
  "ignorePatterns": [".next/**", "e2e/**", "scripts/**"],
  "ignoreFindings": ["convex/_generated/**", "confect/_generated/**"],
  "dynamicallyLoaded": ["confect/**/*.impl.ts", "confect/impl.ts", "confect/spec.ts"],
  "ignoreExports": [
    {
      "file": "shared/i18n/navigation.ts",
      "exports": ["usePathname"]
    },
    {
      "file": "shared/ui/alert.tsx",
      "exports": ["AlertAction"]
    },
    {
      "file": "shared/ui/avatar.tsx",
      "exports": ["AvatarImage", "AvatarGroup", "AvatarGroupCount"]
    },
    {
      "file": "shared/ui/badge.tsx",
      "exports": ["badgeVariants"]
    },
    {
      "file": "shared/ui/button.tsx",
      "exports": ["buttonVariants"]
    },
    {
      "file": "shared/ui/card.tsx",
      "exports": ["CardHeader", "CardFooter", "CardTitle", "CardAction", "CardDescription"]
    },
    {
      "file": "confect/lib/types.ts",
      "exports": ["DatabaseReader", "DatabaseWriter"]
    }
  ],
  "ignoreUnresolvedImports": ["@/messages/**"],
  "ignoreDependencies": ["@confect/test", "@next/playwright", "tailwindcss"],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": ["tsconfig.json", "tsconfig.tests.json", "convex/tsconfig.json"]
  },
  "rules": {
    "private-type-leaks": "error",
    "require-suppression-reason": "error",
    "stale-suppressions": "error"
  },
  "duplicates": {
    "mode": "semantic",
    "near": true,
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 2,
    "ignoreImports": true,
    "threshold": 5.6,
    "ignoredClones": [
      "dup:2e174d80:2",
      "dup:33a7c5c4:2",
      "dup:8691c349:2",
      "dup:9ed7c5ca:2",
      "dup:146daa20:2",
      "dup:ec5a72c6:2",
      "dup:65e19125:2",
      "dup:66964408:2",
      "dup:776beb96:2",
      "dup:dd04a2c5:2",
      "dup:c77b3abb6f87acd9-1:2",
      "dup:c77b3abb6f87acd9-2:2",
      "dup:c77b3abb6f87acd9-3:2",
      "dup:c77b3abb6f87acd9-4:3",
      "dup:ce28b3f5:2"
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "coverage": "coverage/coverage-final.json",
    "thresholdOverrides": [
      {
        "files": ["game/ui/player-lane.tsx"],
        "functions": ["PlayerLaneSidebar"],
        "maxCognitive": 17,
        "reason": "The sidebar intentionally renders independent status, role, target, action, and animation badges."
      },
      {
        "files": ["game/ui/player-lane.tsx"],
        "functions": ["PlayerLane"],
        "maxCognitive": 24,
        "reason": "The lane combines orthogonal interaction states that cannot be represented as one discriminated variant."
      },
      {
        "files": ["game/cards/number-content.tsx"],
        "functions": ["NumberCardContent"],
        "maxCrap": 150,
        "reason": "Exhaustive number-name switch replaces dynamic i18n keys; branches are literal translations, not business logic."
      }
    ]
  },
  "boundaries": {
    "zones": [
      {
        "name": "generated",
        "patterns": ["convex/_generated/**", "confect/_generated/**"]
      },
      {
        "name": "tests",
        "patterns": ["tests/**", "game/**/*.test.tsx", "game/**/*.vitest.tsx"]
      },
      {
        "name": "adapters",
        "patterns": ["shared/analytics/posthog-convex.ts"]
      },
      {
        "name": "logic",
        "patterns": ["game/logic/**"]
      },
      {
        "name": "application",
        "patterns": ["game/application/**"]
      },
      {
        "name": "infrastructure",
        "patterns": ["game/infrastructure/**"]
      },
      {
        "name": "backend",
        "patterns": ["convex/**", "confect/**"]
      },
      {
        "name": "shared",
        "patterns": ["shared/**"]
      },
      {
        "name": "ui",
        "patterns": [
          "app/**",
          "game/cards/**",
          "game/hooks/**",
          "game/screens/**",
          "game/ui/**",
          "lib/**",
          "proxy.ts"
        ]
      }
    ],
    "rules": [
      {
        "from": "logic",
        "allow": ["shared", "generated"]
      },
      {
        "from": "application",
        "allow": ["logic", "infrastructure", "shared", "adapters", "generated"]
      },
      {
        "from": "infrastructure",
        "allow": ["logic", "application", "backend", "shared", "generated"]
      },
      {
        "from": "backend",
        "allow": ["logic", "application", "infrastructure", "shared", "adapters", "generated"]
      },
      {
        "from": "shared",
        "allow": ["generated"]
      },
      {
        "from": "adapters",
        "allow": ["logic", "backend", "shared", "generated"]
      },
      {
        "from": "ui",
        "allow": ["logic", "application", "backend", "shared", "adapters", "generated"]
      },
      {
        "from": "tests",
        "allow": [
          "logic",
          "application",
          "infrastructure",
          "backend",
          "shared",
          "adapters",
          "ui",
          "generated"
        ]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "*.config.ts",
        "*.config.mjs",
        "global.d.ts",
        "messages/**",
        "scripts/**",
        "e2e/**"
      ]
    }
  },
  "audit": {
    "typeAware": true,
    "gate": "all"
  }
}
