{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,route,default}.{ts,tsx}",
    "confect/tables/**/*.ts",
    "convex/**/*.ts",
    "shared/i18n/request.ts"
  ],
  "ignorePatterns": [".next/**", "e2e/**", "scripts/**"],
  "ignoreFindings": ["convex/_generated/**", "confect/_generated/**"],
  "dynamicallyLoaded": ["confect/**/*.impl.ts", "confect/impl.ts", "confect/spec.ts"],
  "ignoreExports": [
    {
      "file": "shared/ui/*.tsx",
      "exports": ["*"]
    },
    {
      "file": "shared/i18n/navigation.ts",
      "exports": ["usePathname"]
    }
  ],
  "ignoreUnresolvedImports": ["@/messages/**"],
  "ignoreDependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "shadcn",
    "tw-animate-css",
    "tailwindcss",
    "@confect/test",
    "@effect/vitest",
    "convex-test",
    "eslint-plugin-i18next"
  ],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": ["tsconfig.json", "tsconfig.tests.json", "convex/tsconfig.json"]
  },
  "rules": {
    "private-type-leaks": "error",
    "require-suppression-reason": "error"
  },
  "duplicates": {
    "mode": "semantic",
    "near": true,
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "coverage": "coverage/coverage-final.json"
  },
  "boundaries": {
    "zones": [
      { "name": "generated", "patterns": ["convex/_generated/**", "confect/_generated/**"] },
      { "name": "tests", "patterns": ["tests/**", "game/**/*.test.tsx", "game/**/*.vitest.tsx"] },
      {
        "name": "adapters",
        "patterns": ["shared/analytics/posthog-convex.ts", "shared/lib/loose-translate.ts"]
      },
      { "name": "logic", "patterns": ["game/logic/**"] },
      { "name": "application", "patterns": ["game/application/**"] },
      { "name": "infrastructure", "patterns": ["game/infrastructure/**"] },
      { "name": "backend", "patterns": ["convex/**", "confect/**"] },
      { "name": "shared", "patterns": ["shared/**"] },
      {
        "name": "ui",
        "patterns": [
          "app/**",
          "game/cards/**",
          "game/hooks/**",
          "game/screens/**",
          "game/ui/**",
          "lib/**",
          "proxy.ts"
        ]
      }
    ],
    "rules": [
      { "from": "logic", "allow": ["shared", "generated"] },
      {
        "from": "application",
        "allow": ["logic", "infrastructure", "shared", "adapters", "generated"]
      },
      {
        "from": "infrastructure",
        "allow": ["logic", "application", "backend", "shared", "generated"]
      },
      {
        "from": "backend",
        "allow": ["logic", "application", "infrastructure", "shared", "adapters", "generated"]
      },
      { "from": "shared", "allow": ["generated"] },
      { "from": "adapters", "allow": ["logic", "backend", "shared", "generated"] },
      {
        "from": "ui",
        "allow": ["logic", "application", "backend", "shared", "adapters", "generated"]
      },
      {
        "from": "tests",
        "allow": [
          "logic",
          "application",
          "infrastructure",
          "backend",
          "shared",
          "adapters",
          "ui",
          "generated"
        ]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["*.config.ts", "*.config.mjs", "global.d.ts", "scripts/**", "e2e/**"]
    }
  },
  "audit": {
    "typeAware": true,
    "gate": "new-only"
  },
  "regression": {
    "baseline": {
      "analysisIdentity": {
        "mode": "type-aware",
        "semantic_schema_version": 2,
        "capabilities": ["symbol-use", "api-surface"],
        "project_config_hash": "deferred:no-semantic-queries",
        "backend_family": "typescript-go",
        "completeness": "complete"
      },
      "totalIssues": 80,
      "unusedFiles": 1,
      "unusedExports": 0,
      "unusedTypes": 0,
      "unusedDependencies": 0,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 0,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 0,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "devDependenciesInProduction": 0,
      "boundaryViolations": 0,
      "boundaryCoverageViolations": 0,
      "boundaryCallViolations": 0,
      "policyViolations": 0
    }
  }
}
