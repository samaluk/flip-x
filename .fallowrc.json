{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,route,default}.{ts,tsx}",
    "confect/tables/**/*.ts",
    "convex/**/*.ts",
    "shared/i18n/request.ts"
  ],
  "ignorePatterns": [".next/**", "e2e/**", "scripts/**"],
  "ignoreFindings": ["convex/_generated/**", "confect/_generated/**"],
  "dynamicallyLoaded": ["confect/**/*.impl.ts", "confect/impl.ts", "confect/spec.ts"],
  "ignoreExports": [
    {
      "file": "shared/ui/*.tsx",
      "exports": ["*"]
    },
    {
      "file": "shared/i18n/navigation.ts",
      "exports": ["usePathname"]
    }
  ],
  "ignoreUnresolvedImports": ["@/messages/**"],
  "ignoreDependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "shadcn",
    "tw-animate-css",
    "tailwindcss",
    "@confect/test",
    "@effect/vitest",
    "convex-test",
    "eslint-plugin-i18next"
  ],
  "typeAware": {
    "enabled": true,
    "require": "complete",
    "projects": ["tsconfig.json", "tsconfig.tests.json", "convex/tsconfig.json"]
  },
  "rules": {
    "private-type-leaks": "warn"
  },
  "duplicates": {
    "mode": "semantic",
    "minLines": 8,
    "minTokens": 60,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "audit": {
    "typeAware": false,
    "gate": "new-only",
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  }
}
