{
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "jsPlugins": [
    {
      "name": "landmines-testing",
      "specifier": "@interfere/landmines/testing"
    }
  ],
  "rules": {
    "landmines-testing/no-test-doubles": "error",
    "landmines-testing/strict-msw": "error",
    "landmines-testing/no-fixed-sleep": "error",
    "landmines-testing/no-unsignaled-poll": "error",
    "landmines-testing/no-flake-masking": [
      "error",
      {
        "allow": {
          "tests/unit/shared/posthog-source-maps.test.ts": 1,
          "vitest.config.ts": 3,
          "vitest.convex.config.ts": 2
        }
      }
    ]
  }
}
