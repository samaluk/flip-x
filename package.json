{
  "name": "flip-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "confect:codegen": "confect codegen",
    "confect:dev": "confect dev",
    "dev": "portless",
    "dev:app": "next dev",
    "convex:dev": "convex dev",
    "convex:delete-preview": "node scripts/delete-convex-preview.mjs",
    "dev:stack": "convex dev --start 'pnpm dev'",
    "ci:local": "pnpm design:lint && pnpm lint && pnpm i18n:check && pnpm test:coverage && pnpm fallow:audit && pnpm fallow:full && pnpm build",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:core && pnpm lint:tailwind",
    "lint:core": "oxlint . --ignore-path .oxlintignore",
    "lint:tailwind": "oxlint . --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "lint:fix": "pnpm lint:fix:core && pnpm lint:fix:tailwind",
    "lint:fix:core": "oxlint --fix . --ignore-path .oxlintignore",
    "lint:fix:tailwind": "oxlint --fix . --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "i18n:check": "eloqnt lint",
    "design:lint": "pnpm exec design.md lint DESIGN.md",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --project engine --project infrastructure --project contract --project ui --project confect",
    "test:engine": "vitest run --project engine",
    "test:infra": "vitest run --project infrastructure",
    "test:contract": "vitest run --project contract",
    "test:ui": "vitest run --project ui",
    "test:confect": "vitest run --project confect",
    "test:coverage": "vitest run --coverage --project engine --project infrastructure --project contract --project ui --project confect",
    "test:smoke:backend": "bash scripts/convex-preview-test.sh pnpm vitest run --config vitest.convex.config.ts",
    "test:backend": "pnpm test:smoke:backend",
    "test:e2e": "bash scripts/convex-preview-test.sh pnpm playwright test",
    "test:vrt": "bash scripts/vrt-docker.sh",
    "test:vrt:update": "bash scripts/vrt-docker.sh --update",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code --fail-on-issues",
    "fallow:dupes": "fallow dupes --fail-on-issues",
    "fallow:health": "fallow health --fail-on-issues",
    "fallow:audit": "fallow audit",
    "fallow:staged": "fallow audit --base HEAD",
    "fallow:full": "pnpm fallow:dead-code && pnpm fallow:dupes && pnpm fallow:health",
    "react-doctor": "react-doctor --verbose",
    "react-doctor:staged": "react-doctor --staged --yes --no-score --blocking warning --project flip-x",
    "react-doctor:changed": "react-doctor --scope changed --base origin/master --yes --no-score --blocking warning --project flip-x",
    "react-doctor:full": "react-doctor --scope full --yes --no-score --blocking warning --project flip-x"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@confect/core": "10.0.0",
    "@confect/react": "10.0.0",
    "@confect/server": "10.0.0",
    "@convex-dev/migrations": "0.3.6",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/rate-limiter": "0.4.1",
    "@posthog/convex": "2.1.5",
    "@posthog/next": "0.9.0",
    "@sholajegede/convex-cascading-deletes": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.46.0",
    "convex-helpers": "0.1.127",
    "effect": "4.0.2",
    "lucide-react": "1.53.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@confect/cli": "10.0.0",
    "@confect/test": "10.0.0",
    "@effect/vitest": "4.0.2",
    "@eloqnt/cli": "0.6.33",
    "@google/design.md": "0.4.0",
    "@next/playwright": "16.4.0",
    "@playwright/test": "1.64.0",
    "@posthog/nextjs-config": "1.11.1",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "convex-test": "0.0.60",
    "eslint-plugin-i18next": "6.1.5",
    "fallow": "3.31.0",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "1.14.0",
    "oxlint-tsgolint": "7.0.2003",
    "portless": "0.15.7",
    "react-doctor": "0.9.17",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.10.1",
  "portless": {
    "name": "flip-x",
    "script": "dev:app"
  }
}
